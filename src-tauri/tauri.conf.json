{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tunnelo",
  "version": "0.1.0",
  "identifier": "io.github.aftandilmmd.tunnelo",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tunnelo",
        "width": 420,
        "height": 640,
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Network",
    "shortDescription": "Desktop client for OpenVPN 3",
    "longDescription": "Import .ovpn profiles and connect with one click. Uses the openvpn3-linux services.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "openvpn3"
        ]
      },
      "rpm": {
        "depends": [
          "openvpn3-client"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyMUJDRDZGOTQwM0U4NzYKUldSMjZBT1ViODBiSXRZeXU5OWxFOUJDb1BYY1ROSFNwTnFIZ3U0NmRHMTQ1NUxtZkhzVmZCamcK",
      "endpoints": [
        "https://github.com/aftandilmmd/openvpn-linux-client/releases/latest/download/latest.json"
      ]
    }
  }
}
